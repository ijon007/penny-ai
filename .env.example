SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=

# Google Gemini via Vercel AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=

# Public iMessage number for the landing page CTA (E.164)
NEXT_PUBLIC_IMESSAGE_NUMBER=+15555550100

# Optional override for Penny's personality
# PENNY_SYSTEM_PROMPT=

# Optional Gemini model override (default gemini-3.5-flash)
