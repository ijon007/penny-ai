# Photon Spectrum (https://photon.codes)
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
SPECTRUM_WEBHOOK_SECRET=

# Google Gemini via Vercel AI SDK
GOOGLE_GENERATIVE_AI_API_KEY=

# Public iMessage number for the landing page CTA (E.164)
NEXT_PUBLIC_IMESSAGE_NUMBER=+15555550100

# Optional override for Penny's personality
# PENNY_SYSTEM_PROMPT=

# Optional Gemini model override (default gemini-3.5-flash)
# PENNY_GEMINI_MODEL=gemini-3.5-flash

# Optional durable finance ledger (Postgres). Without it, Penny runs MOCK/DEMO
# mode: seeded reads + session-only mutations; automated cron digests stay OFF.
# PENNY_DATABASE_URL=
# DATABASE_URL=
# POSTGRES_URL=

# Required together with Postgres before enabling outbound digests
# CRON_SECRET=
