# Durable finance ledger (required for finance features in production)
# PENNY_DATABASE_URL=
# DATABASE_URL=
# POSTGRES_URL=

# Vercel Cron auth for /api/cron/finance
# CRON_SECRET=

# Explicit local-only memory store (NOT for production)
# PENNY_ALLOW_MEMORY_STORE=1
